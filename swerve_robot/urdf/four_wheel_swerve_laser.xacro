<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- ========== 激光雷达支架参数 ========== -->
  <xacro:property name="post_height_cm" value="12.0"/>    <!-- 立柱高度 -->
  <xacro:property name="post_radius_cm" value="1.5"/>     <!-- 立柱圆柱半径 -->
  <xacro:property name="laser_base_thick_cm" value="1.0"/><!-- 雷达底座厚度 -->
  <xacro:property name="laser_length_cm" value="6.0"/>    <!-- 单线雷达本体长度 -->
  <xacro:property name="laser_width_cm" value="6.0"/>     <!-- 雷达宽度 -->
  <xacro:property name="laser_height_cm" value="3.0"/>    <!-- 雷达高度 -->

  <!-- 单位转换 cm -> m -->
  <xacro:property name="post_h" value="${post_height_cm / 100.0}"/>
  <xacro:property name="post_r" value="${post_radius_cm / 100.0}"/>
  <xacro:property name="laser_base_t" value="${laser_base_thick_cm / 100.0}"/>
  <xacro:property name="laser_l" value="${laser_length_cm / 100.0}"/>
  <xacro:property name="laser_w" value="${laser_width_cm / 100.0}"/>
  <xacro:property name="laser_h" value="${laser_height_cm / 100.0}"/>

  <!-- 雷达安装高度：底盘顶面中心向上 -->
  <xacro:property name="chassis_top_z" value="${0.03}"/> <!-- 你底盘厚度10cm，半厚0.05m，这里对应base_link顶面z=0.05，注意！下面会修正 -->

  <!-- ========== 雷达立柱支架 link ========== -->
  <link name="laser_post_link">
    <visual>
      <origin xyz="0 0 ${post_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${post_r}" length="${post_h}"/>
      </geometry>
      <material name="silver">
        <color rgba="0.7 0.7 0.7 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${post_h/2}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${post_r}" length="${post_h}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${post_h/2}"/>
      <mass value="0.08"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- 固定关节：立柱固定在base_link顶面中心 -->
  <joint name="laser_post_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_post_link"/>
    <origin xyz="0 0 ${0.05}" rpy="0 0 0"/> <!-- chassis_thick=0.1m，半厚0.05m，底盘顶面z=0.05 -->
  </joint>

  <!-- ========== 雷达底座 link ========== -->
  <link name="laser_base_link">
    <visual>
      <origin xyz="0 0 ${laser_base_t/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${laser_w} ${laser_w} ${laser_base_t}"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.25 0.25 0.25 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${laser_base_t/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${laser_w} ${laser_w} ${laser_base_t}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${laser_base_t/2}"/>
      <mass value="0.05"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <!-- 底座固定在立柱顶端 -->
  <joint name="laser_base_joint" type="fixed">
    <parent link="laser_post_link"/>
    <child link="laser_base_link"/>
    <origin xyz="0 0 ${post_h}" rpy="0 0 0"/>
  </joint>

  <!-- ========== 单线激光雷达本体 link ========== -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 ${laser_h/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${laser_l} ${laser_w} ${laser_h}"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 0.8"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${laser_h/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${laser_l} ${laser_w} ${laser_h}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${laser_h/2}"/>
      <mass value="0.12"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </link>

  <!-- 雷达固定到底座上方 -->
  <joint name="laser_joint" type="fixed">
    <parent link="laser_base_link"/>
    <child link="laser_link"/>
    <origin xyz="0 0 ${laser_base_t}" rpy="0 0 0"/>
  </joint>

  <!-- ========== Gazebo ROS1 单线激光雷达插件 ========== -->
  <gazebo reference="laser_link">
    <sensor type="ray" name="rplidar">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>20</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_rplidar" filename="libgazebo_ros_laser.so">
        <topicName>/scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

</robot>
